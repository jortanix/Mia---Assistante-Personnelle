# ===== MIA — configuration de production (copier ce fichier vers .env) =====

# Domaine public : soit un vrai domaine pointé vers l'IP publique de la VM
# (ex. mia.exemple.com), soit <nom>.<IP>.sslip.io si tu n'as pas de domaine
# (ex. mia.146.235.40.12.sslip.io). Comme l'IP résout déjà par DNS wildcard,
# Caddy obtient seul un certificat Let's Encrypt valide — l'app iOS l'accepte
# sans rien changer (ATS déjà HTTPS-compatible).
DOMAIN=mia.192.0.2.1.sslip.io

# Clé Django (générer une valeur fraîche) :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-avec-une-vraie-cles

# Clé API des clients mobiles (colle-la dans Réglages de l'app, champ
# « Clé API »). Tu peux réutiliser celle du PC local ou en générer une neuve.
# SANS cette clé, l'API serait ouverte sur Internet -> à ne jamais laisser vide.
MIA_API_KEY=change-me-avec-une-vraie-cles

# Modèle Ollama (Ampere ARM, sans GPU : qwen3:4b-instruct par défaut ; en
# 4 OCPU/24 Go de l'Always Free, qwen3:8b reste très utilisable).
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT=120

# Briefing iCloud (optionnel : si tu laisses vide, le briefing reste hors
# ligne). Note : si un de ces secrets contient un « $ », double-le en « $$ »
# dans .env (précaution docker compose).
BRIEFING_API_KEY=
BRIEFING_TIME_ZONE=Europe/Paris
ICLOUD_APPLE_ID=
ICLOUD_MAIL_LOGIN=
ICLOUD_APP_PASSWORD=
